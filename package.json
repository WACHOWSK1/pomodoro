{
  "name": "pomodoro",
  "version": "1.0.0",
  "description": "",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron electron/main.cjs --dev",
    "package": "npm run build && electron-builder --win --dir --config.directories.output=\"C:/Users/Nitro5 R7/pomodoro_release\"",
    "build:exe": "npm run build && electron-builder --win --config.directories.output=\"C:/Users/Nitro5 R7/pomodoro_release\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WACHOWSK1/pomodoro.git"
  },
  "keywords": [],
  "author": "Focus Mestrado",
  "license": "MIT",
  "type": "module",
  "build": {
    "appId": "br.com.focusmestrado.pomodoro",
    "productName": "Focus Mestrado",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Focus Mestrado"
    }
  },
  "bugs": {
    "url": "https://github.com/WACHOWSK1/pomodoro/issues"
  },
  "homepage": "https://github.com/WACHOWSK1/pomodoro#readme",
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.4"
  }
}
